{
  "name": "library-system",
  "version": "1.0.0",
  "description": "Library Management System for a boarding school. Single-page app (vanilla JS) backed by a Node.js/Express/MongoDB REST API.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./public/css/tailwind.input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./public/css/tailwind.input.css -o ./public/css/tailwind.css --watch",
    "seed:librarian": "node seed/seedLibrarian.js",
    "seed:sample": "node seed/sampleData.js --load",
    "seed:sample:clear": "node seed/sampleData.js --clear"
  },
  "keywords": [
    "library",
    "school",
    "express",
    "mongodb",
    "spa"
  ],
  "author": "Umutoni Jeannette",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=18"
  }
}
