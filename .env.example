# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# Local example: mongodb://127.0.0.1:27017/library-system
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/library-system?retryWrites=true&w=majority
#
# A real Atlas credential was committed here previously and has been removed.
# If you deployed with the old value, ROTATE that database user's password in
# Atlas now: it is in this repository's git history, so removing the line does
# not remove the exposure.
MONGODB_URI=

# ---- Auth ----
# Generate a real secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=8h

# One-off password for the very first librarian account, used only by
# `npm run seed:librarian`. There is no default, and the script refuses to run
# without this set to 12+ characters. Unset it after seeding; the account is
# then maintained through the change-password flow in the admin panel and is
# never touched again by a deploy.
DEFAULT_LIBRARIAN_PASSWORD=

# ---- CORS ----
CLIENT_ORIGIN=http://localhost:5000

# ---- Automated Reminders (scheduler) ----
# Cron expression for daily overdue reminders. Default: 08:00 server time.
REMINDER_CRON=0 8 * * *

# ---- Web Push Notifications ----
# Generate with: node -e "const crypto=require('crypto'); const k=crypto.randomBytes(32).toString('base64url'); console.log('PUSH_PUBLIC_KEY:',k); console.log('PUSH_PRIVATE_KEY:',k)"
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
