# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# Local example: mongodb://127.0.0.1:27017/library-system
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/library-system?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/library-system

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=8h
DEFAULT_LIBRARIAN_PASSWORD=Librarian@2024

# ---- CORS ----
CLIENT_ORIGIN=http://localhost:5000
