# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# Local example: mongodb://127.0.0.1:27017/library-system
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/library-system?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://princeshyakaclever_db_user:rfa3CabGkUIzn92X@cluster0.akflul6.mongodb.net/mbabazi_closet_db?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=8h
DEFAULT_LIBRARIAN_PASSWORD=Librarian@2024

# ---- CORS ----
CLIENT_ORIGIN=http://localhost:5000

# ---- Automated Reminders (scheduler) ----
# Cron expression for daily overdue reminders. Default: 08:00 server time.
REMINDER_CRON=0 8 * * *

# ---- Web Push Notifications ----
# Generate with: node -e "const crypto=require('crypto'); const k=crypto.randomBytes(32).toString('base64url'); console.log('PUSH_PUBLIC_KEY:',k); console.log('PUSH_PRIVATE_KEY:',k)"
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
